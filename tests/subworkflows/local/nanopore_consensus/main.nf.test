nextflow_workflow {

    name "Test Nanopore Consensus Subworkflow with No Pool Split"
    script "subworkflows/local/nanopore_consensus/main.nf"
    workflow "WF_NANOPORE_CONSENSUS"

    test("Nanopore consensus subworkflow with no split pool test") {
        tag "no_split_pool"
        tag "subworkflow"
        tag "amplicon"
        tag "success"

        when {
            params {
                outdir                  = "results"
                clair3_model            = "r1041_e82_400bps_sup_v420"
                platform                = "nanopore"
                clair3_no_pool_split    = true
                primer_bed              = "${projectDir}/test_data/primer.bed"
                // To keep consistent results from downsampled input
                min_length              = 600
                max_length              = 1600
                min_qual_clair3         = 10
                min_depth               = 15
                normalise               = 0
            }
            workflow {
                """
                input[0] = Channel.of([ [id: 'sample2'], file("${projectDir}/test_data/nanopore/fastqs/sample2.fastq.gz") ])
                input[1] = Channel.of([ file("${projectDir}/test_data/MN908947.3.reference.fasta") ])
                input[2] = Channel.of([ file("${projectDir}/test_data/nanopore/MN908947.3.reference.fasta.fai") ])
                input[3] = Channel.of([ file("${projectDir}/test_data/nanopore/refstats.txt") ])
                input[4] = Channel.of([ file("${projectDir}/test_data/primer.bed") ])
                input[5] = Channel.of([ file("${projectDir}/test_data/nanopore/amplicon.bed") ])
                """
            }
        }

        then {
            assert workflow.success

            // Tiling bed only in the no split pool one
            assert path("$launchDir/results/bed/tiling_region.bed").exists()
            assert path("$launchDir/results/bed/tiling_region.bed").readLines().size() == 1
            assert path("$launchDir/results/bed/tiling_region.bed").text.contains("MN908947.3\t54\t29768")
            //  Consensus Fasta files
            assert path("$launchDir/results/consensus/sample2.consensus.fasta").md5 == "b0357754cbb862748f58bf03bf7bd2b4"
        }
    }

}
