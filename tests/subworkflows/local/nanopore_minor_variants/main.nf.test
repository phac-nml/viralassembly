nextflow_workflow {

    name "Test minor variants subworkflow"
    script "subworkflows/local/nanopore_minor_variants/main.nf"
    workflow "WF_NANOPORE_MINOR_VARIANTS"

    test("Minor variants subworkflow test") {
        tag "minor_variants"
        tag "subworkflow"

        when {
            params {
                outdir = "results/"
            }
            workflow {
                """
                input[0] = Channel.of([ [id: 'sample1'], file("${projectDir}/test_data/nanopore/bams/sample1.sorted.bam"), file("${projectDir}/test_data/nanopore/bams/sample1.sorted.bam.bai")])
                input[1] = file("${projectDir}/test_data/MN908947.3.reference.fasta")
                input[2] = file("${projectDir}/test_data/MN908947.3.reference.fasta.fai")
                input[3] = Channel.of([ [id: 'sample1'], file("${projectDir}/test_data/nanopore/vcfs/sample1.pass.norm.vcf.gz")])
                input[4] = Channel.value('ont_r10_dorado_sup_5khz')
                """
            }
        }
        then {
            assert workflow.success

            //Check for output vcfs
            assert path("$launchDir/results/vcf/minor_variants/sample1-minor.vcf.gz").exists()
            assert path("$launchDir/results/vcf/minor_variants/sample1-full.vcf.gz").exists()
            // Read gzipped vcf and check line counts
            def lines_full = path("$launchDir/results/vcf/minor_variants/sample1-full.vcf.gz").linesGzip
            assert lines_full.size() == 60
            def lines = path("$launchDir/results/vcf/minor_variants/sample1-minor.vcf.gz").linesGzip
            assert lines.size() == 63
            // Check for a specific snp and indel:
            assert lines.any { it.contains("5386") }
            assert lines.any { it.contains("28214") }
        }
    }
}
