nextflow_workflow {

    name "Test subconsensus subworkflow"
    script "subworkflows/local/nanopore_subconsensus/main.nf"
    workflow "WF_NANOPORE_SUBCONSENSUS" 

    test("Subconsensus subworkflow test") {
        tag "subconsensus"

        when {
            params {
                outdir = "results/subcon_tests/"
            }
            workflow {
                """
                input[0] = Channel.of([ [id: 'sample1'], file("${projectDir}/test_data/nanopore/bams/sample1.sorted.bam"), file("${projectDir}/test_data/nanopore/bams/sample1.sorted.bam.bai")])
                input[1] = file("${projectDir}/test_data/nanopore/MN908947.3.reference.fasta")
                input[2] = file("${projectDir}/test_data/nanopore/MN908947.3.reference.fasta.fai")
                input[3] = Channel.of([ [id: 'sample1'], file("${projectDir}/test_data/nanopore/vcfs/sample1.pass.norm.vcf.gz")])
                """
            }
        }

        then {
            assert workflow.success

            //Check for output vcf
            assert path("$launchDir/results/subcon_tests/vcf/sample1-minorvar.vcf.gz").exists()
            // Read gzipped vcf
            def lines = path("$launchDir/results/subcon_tests/vcf/sample1-minorvar.vcf.gz").linesGzip
            assert lines.size() == 65
            // Check for a specific snp and indel:
            assert lines.any { it.contains("5386") }
            assert lines.any { it.contains("28214") }
        }

    }

}
