            // Sample Name: negative-ctrl
            assert iridanext_metadata.negative_ctrl.num_aligned_reads == "0"
            assert iridanext_metadata.negative_ctrl.num_consensus_n == "29903"
            assert iridanext_metadata.negative_ctrl.genome_completeness == "0.0"
            assert iridanext_metadata.negative_ctrl.mean_sequencing_depth == "0.0"
            assert iridanext_metadata.negative_ctrl.median_sequencing_depth == "0"
            assert iridanext_metadata.negative_ctrl.total_variants == "0"
            assert iridanext_metadata.negative_ctrl.num_snps == "0"
            assert iridanext_metadata.negative_ctrl.num_deletions == "0"
            assert iridanext_metadata.negative_ctrl.num_deletion_sites == "0"
            assert iridanext_metadata.negative_ctrl.num_insertions == "0"
            assert iridanext_metadata.negative_ctrl.num_insertion_sites == "0"
            assert iridanext_metadata.negative_ctrl.qc_pass == "PASS"
            assert iridanext_metadata.negative_ctrl.neg_control_info == "PASS"
            assert iridanext_metadata.negative_ctrl.run_status == "PASS"
            assert iridanext_metadata.negative_ctrl.run_summary == ""
            assert iridanext_metadata.negative_ctrl.pipeline_name == "artic-generic-nf"
            assert iridanext_metadata.negative_ctrl.pipeline_version == "1.2.0-dev"

            // Sample Name: sample1 && sample2 as they are the same
            assert iridanext_metadata.sample1.num_aligned_reads == "7597"
            assert iridanext_metadata.sample2.num_consensus_n == "2698"
            assert iridanext_metadata.sample1.genome_completeness == "0.9097"
            assert iridanext_metadata.sample2.mean_sequencing_depth == "254.22"
            assert iridanext_metadata.sample1.median_sequencing_depth == "210"
            assert iridanext_metadata.sample2.total_variants == "55"
            assert iridanext_metadata.sample1.num_snps == "50"
            assert iridanext_metadata.sample2.num_deletions == "30"
            assert iridanext_metadata.sample1.num_deletion_sites == "5"
            assert iridanext_metadata.sample2.num_insertions == "0"
            assert iridanext_metadata.sample1.num_insertion_sites == "0"
            assert iridanext_metadata.sample2.qc_pass == "PASS"
            assert iridanext_metadata.sample1.neg_control_info == "NA"
            assert iridanext_metadata.sample2.run_status == "PASS"
            assert iridanext_metadata.sample1.run_summary == ""
            assert iridanext_metadata.sample2.pipeline_name == "artic-generic-nf"
            assert iridanext_metadata.sample1.pipeline_version == "1.2.0-dev"

            // Pipeline info and tracking
            assert path("$launchDir/results/pipeline_info").exists()
            assert path("$launchDir/results/pipeline_info/software_versions.yml").exists()
        }
    }
}
