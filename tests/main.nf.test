// Main Tests File
nextflow_pipeline {

    name "Full Pipeline NF-Tests for MeaSeq"
    script "main.nf"

    //--- Test 1 ----------------------------------------------------------------------------
    test("Missing data input") {
        tag "fail"

        when {
            params {
                outdir      = "results"
                reference   = "${projectDir}/test_data/nanopore/MN908947.3.reference.fasta"
            }
        }
        then {
            // Status
            assert workflow.failed

            // Message
            //  stdout as its in the log
            assert workflow.stdout.contains("ERROR ~ Please provide input data with either: \'--input input.csv\' or \'--fastq_pass fastq_dir/\'")
        }
    }

    //--- Test 2 ----------------------------------------------------------------------------
    test("Both data inputs") {
        tag "fail"

        when {
            params {
                outdir      = "results"
                reference   = "${projectDir}/test_data/nanopore/MN908947.3.reference.fasta"
                input       = "${projectDir}/test_data/nanopore/input.csv"
                fastq_pass  = "${projectDir}/test_data/nanopore/fastq_pass"
            }
        }
        then {
            // Status
            assert workflow.failed

            // Message
            assert workflow.stdout.contains("ERROR ~ Please provide input data with either: \'--input input.csv\' or \'--fastq_pass fastq_dir/\' but not both")
        }
    }

    //--- Test 3 ----------------------------------------------------------------------------
    test("Missing Reference") {
        tag "fail"

        when {
            params {
                outdir      = "results"
                fastq_pass  = "${projectDir}/test_data/nanopore/fastq_pass"
            }
        }
        then {
            // Status
            assert workflow.failed

            // Message
            assert workflow.stderr.contains("* Missing required parameter: --reference")
        }
    }

    /*
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
                                        Passing Tests
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    */
    //--- Test 4 ----------------------------------------------------------------------------
    test("Nanopore WGS Workflow") {
        tag "success"

        when {
            params {
                outdir          = "results"
                input           = "${projectDir}/test_data/nanopore/input.csv"
                reference       = "${projectDir}/test_data/nanopore/MN908947.3.reference.fasta"
                clair3_model    = "r1041_e82_400bps_sup_v420"
                skip_snpeff     = true
                // To keep consistent results from downsampled input
                min_length      = 600
                max_length      = 1600
                min_qual_clair3 = 10
                min_depth       = 15
            }
        }
        then {
            // Status
            assert workflow.success
            assert workflow.trace.failed().size() == 0

            //
            // Channels and Files Exist
            //
            def lines = []
            assert path("$launchDir/results").exists()

            // Final QC File
            assert path("$launchDir/results/overall.qc.csv").exists()
            // Using columns up to snp count
            lines = path("$launchDir/results/overall.qc.csv").text
            assert lines.contains("sample,num_aligned_reads,num_consensus_n,genome_completeness,mean_sequencing_depth,median_sequencing_depth,total_variants,num_snps,")
            assert lines.contains("reads_100,66,29903,0.0,2.3,2,0,0,")
            assert lines.contains("reads_25,0,29903,0.0,0.0,0,0,0,")
            assert lines.contains("negative-ctrl,0,29903,0.0,0.0,0,0,0,")
            assert lines.contains("sample1,7598,1154,0.9614,264.27,217,54,49,")
            assert lines.contains("sample2,7598,1154,0.9614,264.27,217,54,49,")

            // Intermediate generated reference files
            assert path("$launchDir/results/reference/MN908947.3.reference.fasta.fai").exists()
            lines = path("$launchDir/results/reference/MN908947.3.reference.fasta.fai").text
            assert lines.contains("MN908947.3\t29903\t12\t60\t61")

            assert path("$launchDir/results/reference/genome.bed").exists()
            lines = path("$launchDir/results/reference/genome.bed").text
            assert lines.contains("MN908947.3\t0\t29903")

            // Sample Outputs
            //  Fasta files
            assert path("$launchDir/results/consensus/reads_100.consensus.fasta").md5 == "4493f765193dec5917ba9fa18da5e909"
            lines = path("$launchDir/results/consensus/reads_100.consensus.fasta").readLines()
            assert lines.contains(">reads_100 MN908947.3")
            assert lines.contains("NNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNN")
            assert lines.size() == 500

            assert path("$launchDir/results/consensus/sample1.consensus.fasta").md5 == "655b5e5d7b569592262166a1c2a0c40b"
            lines = path("$launchDir/results/consensus/sample1.consensus.fasta").readLines()
            assert lines.contains(">sample1 MN908947.3")
            assert lines.contains("NNNNNNNNNNNNNNNNNNNNNNNNNNNNNNACCAACCAACTTTCGATCTCTTGTAGATCT")
            assert lines.size() == 499

            assert path("$launchDir/results/consensus/sample2.consensus.fasta").md5 == "66fc19ba219677fb31162a6576395186"
            lines = path("$launchDir/results/consensus/sample2.consensus.fasta").readLines()
            assert lines.contains(">sample2 MN908947.3")
            assert lines.contains("NNNNNNNNNNNNNNNNNNNNNNNNNNNNNNACCAACCAACTTTCGATCTCTTGTAGATCT")
            assert lines.size() == 499

            //  Reporting file intermediates
            assert path("$launchDir/results/variation_csvs/sample1_variation.csv").exists()
            lines = path("$launchDir/results/variation_csvs/sample1_variation.csv").readLines()
            assert lines.size() == 168
            assert lines.contains("position,chrom,A,C,T,G,del,ins,total_reads,percentage_nonref,ref_base,variant_type,distribution")
            assert lines.contains("241,MN908947.3,0,0,318,0,27,0,345,100.0,C,T SNP,NA")

            assert path("$launchDir/results/variation_csvs/sample2_variation.csv").exists()
            lines = path("$launchDir/results/variation_csvs/sample2_variation.csv").readLines()
            assert lines.size() == 168
            assert lines.contains("position,chrom,A,C,T,G,del,ins,total_reads,percentage_nonref,ref_base,variant_type,distribution")
            assert lines.contains("241,MN908947.3,0,0,318,0,27,0,345,100.0,C,T SNP,NA")

            // Final Reports
            assert path("$launchDir/results/reportDashboard.html").exists()

            // IRIDA Next output
            def iridanext_json = path("$launchDir/results/iridanext.output.json").json
            def iridanext_global = iridanext_json.files.global
            def iridanext_samples = iridanext_json.files.samples
            def iridanext_metadata = iridanext_json.metadata.samples

            assert iridanext_global.findAll { it.path == "reportDashboard.html" }.size() == 1
            assert iridanext_global.findAll { it.path == "pipeline_info/software_versions.yml" }.size() == 1

            assert iridanext_samples.reads_100.findAll { it.path == "consensus/reads_100.consensus.fasta" }.size() == 1
            assert iridanext_samples.reads_100.findAll { it.path == "vcf/reads_100.pass.norm.vcf.gz" }.size() == 1
            assert iridanext_samples.sample1.findAll { it.path == "consensus/sample1.consensus.fasta" }.size() == 1
            assert iridanext_samples.sample1.findAll { it.path == "vcf/sample1.pass.norm.vcf.gz" }.size() == 1
            assert iridanext_samples.sample2.findAll { it.path == "consensus/sample2.consensus.fasta" }.size() == 1
            assert iridanext_samples.sample2.findAll { it.path == "vcf/sample2.pass.norm.vcf.gz" }.size() == 1

            // Sample Name: reads_100
            assert iridanext_metadata.reads_100.num_aligned_reads == "66"
            assert iridanext_metadata.reads_100.num_consensus_n == "29903"
            assert iridanext_metadata.reads_100.genome_completeness == "0.0"
            assert iridanext_metadata.reads_100.mean_sequencing_depth == "2.3"
            assert iridanext_metadata.reads_100.median_sequencing_depth == "2"
            assert iridanext_metadata.reads_100.total_variants == "0"
            assert iridanext_metadata.reads_100.num_snps == "0"
            assert iridanext_metadata.reads_100.num_deletions == "0"
            assert iridanext_metadata.reads_100.num_deletion_sites == "0"
            assert iridanext_metadata.reads_100.num_insertions == "0"
            assert iridanext_metadata.reads_100.num_insertion_sites == "0"
            assert iridanext_metadata.reads_100.qc_pass == "INCOMPLETE_GENOME;LOW_SEQ_DEPTH"
            assert iridanext_metadata.reads_100.neg_control_info == "NA"
            assert iridanext_metadata.reads_100.run_status == "PASS"
            assert iridanext_metadata.reads_100.run_summary == ""
            assert iridanext_metadata.reads_100.pipeline_name == "artic-generic-nf"
            assert iridanext_metadata.reads_100.pipeline_version == "1.2.0-dev"

            // Sample Name: reads_25
            assert iridanext_metadata.reads_25.num_aligned_reads == "0"
            assert iridanext_metadata.reads_25.num_consensus_n == "29903"
            assert iridanext_metadata.reads_25.genome_completeness == "0.0"
            assert iridanext_metadata.reads_25.mean_sequencing_depth == "0.0"
            assert iridanext_metadata.reads_25.median_sequencing_depth == "0"
            assert iridanext_metadata.reads_25.total_variants == "0"
            assert iridanext_metadata.reads_25.num_snps == "0"
            assert iridanext_metadata.reads_25.num_deletions == "0"
            assert iridanext_metadata.reads_25.num_deletion_sites == "0"
            assert iridanext_metadata.reads_25.num_insertions == "0"
            assert iridanext_metadata.reads_25.num_insertion_sites == "0"
            assert iridanext_metadata.reads_25.qc_pass == "TOO FEW SIZE SELECTED READS"
            assert iridanext_metadata.reads_25.neg_control_info == "NA"
            assert iridanext_metadata.reads_25.run_status == "PASS"
            assert iridanext_metadata.reads_25.run_summary == ""
            assert iridanext_metadata.reads_25.pipeline_name == "artic-generic-nf"
            assert iridanext_metadata.reads_25.pipeline_version == "1.2.0-dev"

            // Sample Name: negative-ctrl with irida_id negative_ctrl
            //  As the `-` doesn't work in `.` notation (as easily)
            assert iridanext_metadata.negative_ctrl.num_aligned_reads == "0"
            assert iridanext_metadata.negative_ctrl.num_consensus_n == "29903"
            assert iridanext_metadata.negative_ctrl.genome_completeness == "0.0"
            assert iridanext_metadata.negative_ctrl.mean_sequencing_depth == "0.0"
            assert iridanext_metadata.negative_ctrl.median_sequencing_depth == "0"
            assert iridanext_metadata.negative_ctrl.total_variants == "0"
            assert iridanext_metadata.negative_ctrl.num_snps == "0"
            assert iridanext_metadata.negative_ctrl.num_deletions == "0"
            assert iridanext_metadata.negative_ctrl.num_deletion_sites == "0"
            assert iridanext_metadata.negative_ctrl.num_insertions == "0"
            assert iridanext_metadata.negative_ctrl.num_insertion_sites == "0"
            assert iridanext_metadata.negative_ctrl.qc_pass == "PASS"
            assert iridanext_metadata.negative_ctrl.neg_control_info == "PASS"
            assert iridanext_metadata.negative_ctrl.run_status == "PASS"
            assert iridanext_metadata.negative_ctrl.run_summary == ""
            assert iridanext_metadata.negative_ctrl.pipeline_name == "artic-generic-nf"
            assert iridanext_metadata.negative_ctrl.pipeline_version == "1.2.0-dev"

            // Sample Name: sample1 && sample2 as they are the same
            assert iridanext_metadata.sample1.num_aligned_reads == "7598"
            assert iridanext_metadata.sample2.num_consensus_n == "1154"
            assert iridanext_metadata.sample1.genome_completeness == "0.9614"
            assert iridanext_metadata.sample2.mean_sequencing_depth == "264.27"
            assert iridanext_metadata.sample1.median_sequencing_depth == "217"
            assert iridanext_metadata.sample2.total_variants == "54"
            assert iridanext_metadata.sample1.num_snps == "49"
            assert iridanext_metadata.sample2.num_deletions == "30"
            assert iridanext_metadata.sample1.num_deletion_sites == "5"
            assert iridanext_metadata.sample2.num_insertions == "0"
            assert iridanext_metadata.sample1.num_insertion_sites == "0"
            assert iridanext_metadata.sample2.qc_pass == "PASS"
            assert iridanext_metadata.sample1.neg_control_info == "NA"
            assert iridanext_metadata.sample2.run_status == "PASS"
            assert iridanext_metadata.sample1.run_summary == ""
            assert iridanext_metadata.sample2.pipeline_name == "artic-generic-nf"
            assert iridanext_metadata.sample1.pipeline_version == "1.2.0-dev"

            // Pipeline info and tracking
            assert path("$launchDir/results/pipeline_info").exists()
            assert path("$launchDir/results/pipeline_info/software_versions.yml").exists()
        }
    }

    //--- Test 5 ----------------------------------------------------------------------------
    test("Nanopore Amplicon Workflow with MultiQC") {
        tag "success"

        when {
            params {
                outdir          = "results"
                input           = "${projectDir}/test_data/nanopore/input.csv"
                clair3_model    = "r1041_e82_400bps_sup_v420"
                reference       = "${projectDir}/test_data/nanopore/MN908947.3.reference.fasta"
                primer_bed      = "${projectDir}/test_data/nanopore/primer.bed"
                metadata        = "${projectDir}/test_data/nanopore/metadata.tsv"
                gff             = "${projectDir}/test_data/nanopore/MN908947.3.gff3"
                multiqc_report  = true
                // To keep consistent results from downsampled input
                min_length      = 600
                max_length      = 1600
                min_qual_clair3 = 10
                min_depth       = 15
                normalise       = 0
            }
        }
        then {
            // Status
            assert workflow.success
            assert workflow.trace.failed().size() == 0

            //
            // Channels and Files Exist
            //
            def lines = []
            assert path("$launchDir/results").exists()

            // Final QC File
            assert path("$launchDir/results/overall.qc.csv").exists()
            // Using columns up to snp count
            lines = path("$launchDir/results/overall.qc.csv").text
            assert lines.contains("sample,num_aligned_reads,num_consensus_n,genome_completeness,mean_sequencing_depth,median_sequencing_depth,total_variants,num_snps,")
            assert lines.contains("reads_100,66,29903,0.0,2.22,2,0,0,")
            assert lines.contains("reads_25,0,29903,0.0,0.0,0,0,0,")
            assert lines.contains("negative-ctrl,0,29903,0.0,0.0,0,0,0,")
            assert lines.contains("sample1,7597,2698,0.9097,254.22,210,55,50,")
            assert lines.contains("sample1,7597,2698,0.9097,254.22,210,55,50,")

            // Intermediate generated reference files
            assert path("$launchDir/results/reference/MN908947.3.reference.fasta.fai").exists()
            lines = path("$launchDir/results/reference/MN908947.3.reference.fasta.fai").text
            assert lines.contains("MN908947.3\t29903\t12\t60\t61")

            assert path("$launchDir/results/reference/genome.bed").exists()
            lines = path("$launchDir/results/reference/genome.bed").text
            assert lines.contains("MN908947.3\t0\t29903")

            assert path("$launchDir/results/reference/refstats.txt").exists()
            lines = path("$launchDir/results/reference/refstats.txt").text
            assert lines.contains("MN908947.3:1-29904")

            // Intermediate generated bed files
            assert path("$launchDir/results/bed/1.bed").exists()
            lines = path("$launchDir/results/bed/1.bed").readLines()
            assert lines.contains("MN908947.3\t54\t1183\tnCoV-2019_1\t1\t+")
            assert lines.size() == 15

            assert path("$launchDir/results/bed/2.bed").exists()
            lines = path("$launchDir/results/bed/2.bed").readLines()
            assert lines.contains("MN908947.3\t1128\t2244\tnCoV-2019_2\t2\t+")
            assert lines.size() == 14

            assert path("$launchDir/results/bed/amplicon.bed").exists()
            lines = path("$launchDir/results/bed/amplicon.bed").readLines()
            assert lines.contains("MN908947.3\t54\t1183\tnCoV-2019_1\t1\t+")
            assert lines.size() == 29

            // Sample Outputs
            //  Fasta files
            assert path("$launchDir/results/consensus/reads_100.consensus.fasta").md5 == "4493f765193dec5917ba9fa18da5e909"
            lines = path("$launchDir/results/consensus/reads_100.consensus.fasta").readLines()
            assert lines.contains(">reads_100 MN908947.3")
            assert lines.contains("NNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNN")
            assert lines.size() == 500

            assert path("$launchDir/results/consensus/sample1.consensus.fasta").md5 == "207b205e3fab4cf95b7cf7b2b140e1cb"
            lines = path("$launchDir/results/consensus/sample1.consensus.fasta").readLines()
            assert lines.contains(">sample1 MN908947.3")
            assert lines.contains("NNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNAGATCT")
            assert lines.size() == 500

            assert path("$launchDir/results/consensus/sample2.consensus.fasta").md5 == "295bc1d4677572db2e6f5706821d370b"
            lines = path("$launchDir/results/consensus/sample2.consensus.fasta").readLines()
            assert lines.contains(">sample2 MN908947.3")
            assert lines.contains("NNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNAGATCT")
            assert lines.size() == 500

            //  Reporting file intermediates
            assert path("$launchDir/results/variation_csvs/sample1_variation.csv").exists()
            lines = path("$launchDir/results/variation_csvs/sample1_variation.csv").readLines()
            assert lines.size() == 169
            assert lines.contains("position,chrom,A,C,T,G,del,ins,total_reads,percentage_nonref,ref_base,variant_type,distribution")
            assert lines.contains("241,MN908947.3,0,0,318,0,27,0,345,100.0,C,T SNP,NA")

            assert path("$launchDir/results/variation_csvs/sample2_variation.csv").exists()
            lines = path("$launchDir/results/variation_csvs/sample2_variation.csv").readLines()
            assert lines.size() == 169
            assert lines.contains("position,chrom,A,C,T,G,del,ins,total_reads,percentage_nonref,ref_base,variant_type,distribution")
            assert lines.contains("241,MN908947.3,0,0,318,0,27,0,345,100.0,C,T SNP,NA")

            // SnpEff outputs
            assert path("$launchDir/results/snpeff/sample1.ann.vcf").exists()
            lines = path("$launchDir/results/snpeff/sample1.ann.vcf").readLines()
            assert lines.size() == 88

            assert path("$launchDir/results/snpeff/sample2.ann.vcf").exists()
            lines = path("$launchDir/results/snpeff/sample2.ann.vcf").readLines()
            assert lines.size() == 88

            assert path("$launchDir/results/snpeff/reads_100.ann.vcf").exists()
            lines = path("$launchDir/results/snpeff/reads_100.ann.vcf").readLines()
            assert lines.size() == 19

            // Final Reports
            assert path("$launchDir/results/Overall-Run-MultiQC.report.html").exists()
            assert path("$launchDir/results/sample_mqc/sample1.report.html").exists()
            assert path("$launchDir/results/sample_mqc/sample2.report.html").exists()

            // IRIDA Next output
            def iridanext_json = path("$launchDir/results/iridanext.output.json").json
            def iridanext_global = iridanext_json.files.global
            def iridanext_samples = iridanext_json.files.samples
            def iridanext_metadata = iridanext_json.metadata.samples

            assert iridanext_global.findAll { it.path == "Overall-Run-MultiQC.report.html" }.size() == 1
            assert iridanext_global.findAll { it.path == "pipeline_info/software_versions.yml" }.size() == 1

            assert iridanext_samples.reads_100.findAll { it.path == "consensus/reads_100.consensus.fasta" }.size() == 1
            assert iridanext_samples.reads_100.findAll { it.path == "vcf/reads_100.pass.norm.vcf.gz" }.size() == 1
            assert iridanext_samples.sample1.findAll { it.path == "consensus/sample1.consensus.fasta" }.size() == 1
            assert iridanext_samples.sample1.findAll { it.path == "vcf/sample1.pass.norm.vcf.gz" }.size() == 1
            assert iridanext_samples.sample1.findAll { it.path == "sample_mqc/sample1.report.html" }.size() == 1
            assert iridanext_samples.sample2.findAll { it.path == "consensus/sample2.consensus.fasta" }.size() == 1
            assert iridanext_samples.sample2.findAll { it.path == "vcf/sample2.pass.norm.vcf.gz" }.size() == 1
            assert iridanext_samples.sample2.findAll { it.path == "sample_mqc/sample2.report.html" }.size() == 1

            // Sample Name: reads_100
            assert iridanext_metadata.reads_100.num_aligned_reads == "66"
            assert iridanext_metadata.reads_100.num_consensus_n == "29903"
            assert iridanext_metadata.reads_100.genome_completeness == "0.0"
            assert iridanext_metadata.reads_100.mean_sequencing_depth == "2.22"
            assert iridanext_metadata.reads_100.median_sequencing_depth == "2"
            assert iridanext_metadata.reads_100.total_variants == "0"
            assert iridanext_metadata.reads_100.num_snps == "0"
            assert iridanext_metadata.reads_100.num_deletions == "0"
            assert iridanext_metadata.reads_100.num_deletion_sites == "0"
            assert iridanext_metadata.reads_100.num_insertions == "0"
            assert iridanext_metadata.reads_100.num_insertion_sites == "0"
            assert iridanext_metadata.reads_100.qc_pass == "INCOMPLETE_GENOME;LOW_SEQ_DEPTH"
            assert iridanext_metadata.reads_100.neg_control_info == "NA"
            assert iridanext_metadata.reads_100.run_status == "PASS"
            assert iridanext_metadata.reads_100.run_summary == ""
            assert iridanext_metadata.reads_100.pipeline_name == "artic-generic-nf"
            assert iridanext_metadata.reads_100.pipeline_version == "1.2.0-dev"

            // Sample Name: reads_25
            assert iridanext_metadata.reads_25.num_aligned_reads == "0"
            assert iridanext_metadata.reads_25.num_consensus_n == "29903"
            assert iridanext_metadata.reads_25.genome_completeness == "0.0"
