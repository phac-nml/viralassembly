// Main Tests File
nextflow_pipeline {

    name "Full Pipeline NF-Tests for MeaSeq"
    script "main.nf"

    //--- Test 1 ----------------------------------------------------------------------------
    test("Missing data input") {
        tag "fail"

        when {
            params {
                outdir      = "results"
                reference   = "${projectDir}/test_data/nanopore/MN908947.3.reference.fasta"
            }
        }
        then {
            // Status
            assert workflow.failed

            // Message
            //  stdout as its in the log
            assert workflow.stdout.contains("ERROR ~ Please provide input data with either: \'--input input.csv\' or \'--fastq_pass fastq_dir/\'")
        }
    }

    //--- Test 2 ----------------------------------------------------------------------------
    test("Both data inputs") {
        tag "fail"

        when {
            params {
                outdir      = "results"
                reference   = "${projectDir}/test_data/nanopore/MN908947.3.reference.fasta"
                input       = "${projectDir}/test_data/nanopore/input.csv"
                fastq_pass  = "${projectDir}/test_data/nanopore/fastq_pass"
            }
        }
        then {
            // Status
            assert workflow.failed

            // Message
            assert workflow.stdout.contains("ERROR ~ Please provide input data with either: \'--input input.csv\' or \'--fastq_pass fastq_dir/\' but not both")
        }
    }

    //--- Test 3 ----------------------------------------------------------------------------
    test("Missing Reference") {
        tag "fail"

        when {
            params {
                outdir      = "results"
                fastq_pass  = "${projectDir}/test_data/nanopore/fastq_pass"
            }
        }
        then {
            // Status
            assert workflow.failed

            // Message
            assert workflow.stderr.contains("* Missing required parameter: --reference")
        }
    }

    /*
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
                                        Passing Tests
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    */
    //--- Test 4 ----------------------------------------------------------------------------
    test("Nanopore WGS Workflow") {
        tag "success"

        when {
            params {
                outdir          = "results"
                input           = "${projectDir}/test_data/nanopore/input.csv"
                reference       = "${projectDir}/test_data/nanopore/MN908947.3.reference.fasta"
                clair3_model    = "r1041_e82_400bps_sup_v420"
            }
        }
        then {
            // Status
            assert workflow.success
            assert workflow.trace.failed().size() == 0

            //
            // Channels and Files Exist
            //
            def lines = []
            assert path("$launchDir/results").exists()

            // Final QC File
            assert path("$launchDir/results/overall.qc.csv").exists()
            // Using columns up to snp count
            lines = path("$launchDir/results/overall.qc.csv").text
            assert lines.contains("sample,num_aligned_reads,num_consensus_n,genome_completeness,mean_sequencing_depth,median_sequencing_depth,total_variants,num_snps,")
            assert lines.contains("reads_100,91,29903,0.0,2.53,2,0,0,")
            assert lines.contains("reads_25,23,29903,0.0,0.64,0,0")
            assert lines.contains("negative-ctrl,0,29903,0.0,0.0,0,0,0,")
            assert lines.contains("sample1,8828,2024,0.9323,279.1,255,49,47,")
            assert lines.contains("sample2,8828,2024,0.9323,279.1,255,49,47,")

            // Intermediate generated reference files
            assert path("$launchDir/results/reference/MN908947.3.reference.fasta.fai").exists()
            lines = path("$launchDir/results/reference/MN908947.3.reference.fasta.fai").text
            assert lines.contains("MN908947.3\t29903\t12\t60\t61")

            assert path("$launchDir/results/reference/genome.bed").exists()
            lines = path("$launchDir/results/reference/genome.bed").text
            assert lines.contains("MN908947.3\t0\t29903")

            // Sample Outputs
            //  Fasta files
            assert path("$launchDir/results/consensus/reads_100.consensus.fasta").md5 == "182e1e06df993c538f932c7d308f77a6"
            lines = path("$launchDir/results/consensus/reads_100.consensus.fasta").readLines()
            assert lines.contains(">reads_100 MN908947.3")
            assert lines.contains("NNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNN")
            assert lines.size() == 500

            assert path("$launchDir/results/consensus/reads_25.consensus.fasta").md5 == "4f23932e4b1da680f53e5d416b87b8ee"
            lines = path("$launchDir/results/consensus/reads_25.consensus.fasta").readLines()
            assert lines.contains(">reads_25 MN908947.3")
            assert lines.contains("NNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNN")
            assert lines.size() == 500

            assert path("$launchDir/results/consensus/sample1.consensus.fasta").md5 == "10bbf8cbe81855aa8e16d5e553c2fd3d"
            lines = path("$launchDir/results/consensus/sample1.consensus.fasta").readLines()
            assert lines.contains(">sample1 MN908947.3")
            assert lines.contains("NNNNNNNNNNNNNNNNNNNNNNNNNNNNNNACCAACCAACTTTCGATCTCTTGTAGATCT")
            assert lines.size() == 500

            assert path("$launchDir/results/consensus/sample2.consensus.fasta").md5 == "635605d9755de1b3d983117ae43119e4"
            lines = path("$launchDir/results/consensus/sample2.consensus.fasta").readLines()
            assert lines.contains(">sample2 MN908947.3")
            assert lines.contains("NNNNNNNNNNNNNNNNNNNNNNNNNNNNNNACCAACCAACTTTCGATCTCTTGTAGATCT")
            assert lines.size() == 500

            //  Reporting file intermediates
            assert path("$launchDir/results/variation_csvs/reads_100_variation.csv").exists()
            lines = path("$launchDir/results/variation_csvs/reads_100_variation.csv").readLines()
            assert lines.size() == 2
            assert lines.contains("position,chrom,A,C,T,G,del,ins,total_reads,percentage_nonref,ref_base,variant_type,distribution")
            assert lines.contains("25767,MN908947.3,0,0,0,8,0,2,10,20.0,G,Ref,NA")

            assert path("$launchDir/results/variation_csvs/sample1_variation.csv").exists()
            lines = path("$launchDir/results/variation_csvs/sample1_variation.csv").readLines()
            assert lines.size() == 510
            assert lines.contains("position,chrom,A,C,T,G,del,ins,total_reads,percentage_nonref,ref_base,variant_type,distribution")
            assert lines.contains("241,MN908947.3,0,0,324,0,27,0,351,100.0,C,T SNP,NA")

            assert path("$launchDir/results/variation_csvs/sample2_variation.csv").exists()
            lines = path("$launchDir/results/variation_csvs/sample2_variation.csv").readLines()
            assert lines.size() == 510
            assert lines.contains("position,chrom,A,C,T,G,del,ins,total_reads,percentage_nonref,ref_base,variant_type,distribution")
            assert lines.contains("241,MN908947.3,0,0,324,0,27,0,351,100.0,C,T SNP,NA")

            // Final Reports
            assert path("$launchDir/results/reportDashboard.html").exists()

            // IRIDA Next output
            def iridanext_json = path("$launchDir/results/iridanext.output.json").json
            def iridanext_global = iridanext_json.files.global
            def iridanext_samples = iridanext_json.files.samples
            def iridanext_metadata = iridanext_json.metadata.samples

            assert iridanext_global.findAll { it.path == "reportDashboard.html" }.size() == 1
            assert iridanext_global.findAll { it.path == "pipeline_info/software_versions.yml" }.size() == 1

            assert iridanext_samples.reads_100.findAll { it.path == "consensus/reads_100.consensus.fasta" }.size() == 1
            assert iridanext_samples.reads_100.findAll { it.path == "vcf/reads_100.pass.norm.vcf.gz" }.size() == 1
            assert iridanext_samples.reads_25.findAll { it.path == "consensus/reads_25.consensus.fasta" }.size() == 1
            assert iridanext_samples.reads_25.findAll { it.path == "vcf/reads_25.pass.norm.vcf.gz" }.size() == 1
            assert iridanext_samples.sample1.findAll { it.path == "consensus/sample1.consensus.fasta" }.size() == 1
            assert iridanext_samples.sample1.findAll { it.path == "vcf/sample1.pass.norm.vcf.gz" }.size() == 1
            assert iridanext_samples.sample2.findAll { it.path == "consensus/sample2.consensus.fasta" }.size() == 1
            assert iridanext_samples.sample2.findAll { it.path == "vcf/sample2.pass.norm.vcf.gz" }.size() == 1

            // Sample Name: reads_100
            assert iridanext_metadata.reads_100.num_aligned_reads == "91"
            assert iridanext_metadata.reads_100.num_consensus_n == "29903"
            assert iridanext_metadata.reads_100.genome_completeness == "0.0"
            assert iridanext_metadata.reads_100.mean_sequencing_depth == "2.53"
            assert iridanext_metadata.reads_100.median_sequencing_depth == "2"
            assert iridanext_metadata.reads_100.total_variants == "0"
            assert iridanext_metadata.reads_100.num_snps == "0"
            assert iridanext_metadata.reads_100.num_deletions == "0"
            assert iridanext_metadata.reads_100.num_deletion_sites == "0"
            assert iridanext_metadata.reads_100.num_insertion == "0"
            assert iridanext_metadata.reads_100.num_insertion_sites == "0"
            assert iridanext_metadata.reads_100.qc_pass == "INCOMPLETE_GENOME;LOW_SEQ_DEPTH"
            assert iridanext_metadata.reads_100.neg_control_info == "NA"
            assert iridanext_metadata.reads_100.run_status == "PASS"
            assert iridanext_metadata.reads_100.run_summary == ""
            assert iridanext_metadata.reads_100.pipeline_name == "artic-generic-nf"
            assert iridanext_metadata.reads_100.pipeline_version == "1.2.0"

            // Sample Name: reads_25
            assert iridanext_metadata.reads_25.num_aligned_reads == "23"
            assert iridanext_metadata.reads_25.num_consensus_n == "29903"
            assert iridanext_metadata.reads_25.genome_completeness == "0.0"
            assert iridanext_metadata.reads_25.mean_sequencing_depth == "0.64"
            assert iridanext_metadata.reads_25.median_sequencing_depth == "0"
            assert iridanext_metadata.reads_25.total_variants == "0"
            assert iridanext_metadata.reads_25.num_snps == "0"
            assert iridanext_metadata.reads_25.num_deletions == "0"
            assert iridanext_metadata.reads_25.num_deletion_sites == "0"
            assert iridanext_metadata.reads_25.num_insertion == "0"
            assert iridanext_metadata.reads_25.num_insertion_sites == "0"
            assert iridanext_metadata.reads_25.qc_pass == "INCOMPLETE_GENOME;LOW_SEQ_DEPTH"
            assert iridanext_metadata.reads_25.neg_control_info == "NA"
            assert iridanext_metadata.reads_25.run_status == "PASS"
            assert iridanext_metadata.reads_25.run_summary == ""
            assert iridanext_metadata.reads_25.pipeline_name == "artic-generic-nf"
            assert iridanext_metadata.reads_25.pipeline_version == "1.2.0"

            // Sample Name: negative-ctrl
            assert iridanext_metadata.negative-ctrl.num_aligned_reads == "0"
            assert iridanext_metadata.negative-ctrl.num_consensus_n == "29903"
            assert iridanext_metadata.negative-ctrl.genome_completeness == "0.0"
            assert iridanext_metadata.negative-ctrl.mean_sequencing_depth == "0"
            assert iridanext_metadata.negative-ctrl.median_sequencing_depth == "0"
            assert iridanext_metadata.negative-ctrl.total_variants == "0"
            assert iridanext_metadata.negative-ctrl.num_snps == "0"
            assert iridanext_metadata.negative-ctrl.num_deletions == "0"
            assert iridanext_metadata.negative-ctrl.num_deletion_sites == "0"
            assert iridanext_metadata.negative-ctrl.num_insertion == "0"
            assert iridanext_metadata.negative-ctrl.num_insertion_sites == "0"
            assert iridanext_metadata.negative-ctrl.qc_pass == "PASS"
            assert iridanext_metadata.negative-ctrl.neg_control_info == "PASS"
            assert iridanext_metadata.negative-ctrl.run_status == "PASS"
            assert iridanext_metadata.negative-ctrl.run_summary == ""
            assert iridanext_metadata.negative-ctrl.pipeline_name == "artic-generic-nf"
            assert iridanext_metadata.negative-ctrl.pipeline_version == "1.2.0"

            // Sample Name: sample1 && sample2 as they are the same
            assert iridanext_metadata.sample1.num_aligned_reads == "8828"
            assert iridanext_metadata.sample2.num_consensus_n == "2024"
            assert iridanext_metadata.sample1.genome_completeness == "0.9323"
            assert iridanext_metadata.sample2.mean_sequencing_depth == "279.1"
            assert iridanext_metadata.sample1.median_sequencing_depth == "255"
            assert iridanext_metadata.sample2.total_variants == "49"
            assert iridanext_metadata.sample1.num_snps == "47"
            assert iridanext_metadata.sample2.num_deletions == "18"
            assert iridanext_metadata.sample1.num_deletion_sites == "2"
            assert iridanext_metadata.sample2.num_insertion == "0"
            assert iridanext_metadata.sample1.num_insertion_sites == "0"
            assert iridanext_metadata.sample2.qc_pass == "PASS"
            assert iridanext_metadata.sample1.neg_control_info == "NA"
            assert iridanext_metadata.sample2.run_status == "PASS"
            assert iridanext_metadata.sample1.run_summary == ""
            assert iridanext_metadata.sample2.pipeline_name == "artic-generic-nf"
            assert iridanext_metadata.sample1.pipeline_version == "1.2.0"

            // Pipeline info and tracking
            assert path("$launchDir/results/pipeline_info").exists()
            assert path("$launchDir/results/pipeline_info/measeq_software_mqc_versions.yml").exists()
        }
