{
    "$schema": "https://json-schema.org/draft-07/schema",
    "$id": "https://raw.githubusercontent.com/phac-nml/viralassembly/main/nextflow_schema.json",
    "title": "phac-nml/viralassembly pipeline parameters",
    "description": "Assemble and QC viral reads",
    "type": "object",
    "definitions": {
        "input_output_options": {
            "title": "Input/output options",
            "type": "object",
            "fa_icon": "fas fa-terminal",
            "description": "Define where the pipeline should find input data using either an input samplesheet or an input directory and where to save data.",
            "properties": {
                "input": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "schema": "assets/schema_input.json",
                    "mimetype": "text/csv",
                    "pattern": "^\\S+\\.csv$",
                    "description": "Path to comma-separated file containing information about the samples in the experiment.",
                    "help_text": "You will need to create a design file with information about the samples in your experiment before running the pipeline. Use this parameter to specify its location. It has to be a comma-separated file with 3 columns, and a header row.",
                    "fa_icon": "fas fa-file-csv"
                },
                "fastq_pass": {
                    "type": "string",
                    "format": "directory-path",
                    "pattern": "^\\S+$",
                    "description": "Path to directory containing either barcoded fastq files or individually named fastq files",
                    "fa_icon": "fas fa-folder-open",
                    "help_text": "Barcodes must be formatted as 'barcode##' to be found. Fastq files must end in '.fastq' or '.fastq.gz'"
                },
                "outdir": {
                    "type": "string",
                    "format": "directory-path",
                    "pattern": "^\\S+$",
                    "description": "The output directory where the results will be saved. You have to use absolute paths to storage on Cloud infrastructure.",
                    "fa_icon": "fas fa-folder-open"
                }
            },
            "required": ["outdir"]
        },
        "required_settings": {
            "title": "Required Settings",
            "type": "object",
            "description": "Settings that are required to run the pipeline",
            "default": "",
            "fa_icon": "fas fa-sign-in-alt",
            "properties": {
                "variant_caller": {
                    "type": "string",
                    "fa_icon": "fas fa-terminal",
                    "description": "Choose which variant caller to use. Options are 'clair3', 'medaka', and 'nanopolish'",
                    "default": "clair3",
                    "enum": ["clair3", "medaka", "nanopolish"]
                },
                "reference": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "mimetype": "text/plain",
                    "pattern": "^\\S+\\.fn?a(sta)$",
                    "description": "Path to reference genome fasta file",
                    "fa_icon": "fas fa-font"
                }
            },
            "required": ["variant_caller", "reference"]
        },
        "amplicon_settings": {
            "title": "Amplicon Settings",
            "type": "object",
            "description": "Settings required for running amplicon data",
            "default": "",
            "fa_icon": "fas fa-sign-in-alt",
            "properties": {
                "primer_bed": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "mimetype": "text/plain",
                    "description": "Path to 6 column (minimum) tab separated amplicon primer bed file with first column matching reference ID",
                    "fa_icon": "fas fa-font"
                }
            }
        },
        "clair3_settings": {
            "title": "Clair3 Settings",
            "type": "object",
            "description": "Settings pertaining to the clair3 variant calling workflow.",
            "default": "",
            "fa_icon": "fas fa-tools",
            "properties": {
                "clair3_model": {
                    "type": "string",
                    "default": "r1041_e82_400bps_sup_v420",
                    "enum": [
                        "r941_prom_sup_g5014",
                        "r941_prom_hac_g360+g422",
                        "r941_prom_hac_g360+g422_1235",
                        "r941_prom_hac_g238",
                        "r1041_e82_400bps_sup_v430_bacteria_finetuned",
                        "hifi_revio",
                        "hifi_sequel2",
                        "ilmn",
                        "r1041_e82_260bps_fast_g632",
                        "r1041_e82_260bps_hac_g632",
                        "r1041_e82_260bps_hac_v400",
                        "r1041_e82_260bps_hac_v410",
                        "r1041_e82_260bps_sup_g632",
                        "r1041_e82_260bps_sup_v400",
                        "r1041_e82_260bps_sup_v410",
                        "r1041_e82_400bps_fast_g615",
                        "r1041_e82_400bps_fast_g632",
                        "r1041_e82_400bps_hac_g615",
                        "r1041_e82_400bps_hac_g632",
                        "r1041_e82_400bps_hac_v400",
                        "r1041_e82_400bps_hac_v410",
                        "r1041_e82_400bps_hac_v420",
                        "r1041_e82_400bps_hac_v430",
                        "r1041_e82_400bps_hac_v500",
                        "r1041_e82_400bps_hac_v520",
                        "r1041_e82_400bps_sup_g615",
                        "r1041_e82_400bps_sup_v400",
                        "r1041_e82_400bps_sup_v410",
                        "r1041_e82_400bps_sup_v420",
                        "r1041_e82_400bps_sup_v430",
                        "r1041_e82_400bps_sup_v500",
                        "r1041_e82_400bps_sup_v520",
                        "r104_e81_hac_g5015",
                        "r104_e81_sup_g5015"
                    ],
                    "description": "Model to use in clair3. See clair3 docs for more info. Be as accurate as possible for best results!"
                },
                "clair3_local_model": {
                    "type": "string",
                    "format": "directory-path",
                    "pattern": "^\\S+$",
                    "exists": true,
                    "description": "Path to local clair3 model folder"
                },
                "clair3_no_pool_split": {
                    "type": "boolean",
                    "description": "Pass to not split amplicon pools when running clair3"
                },
                "min_qual_clair3": {
                    "type": "integer",
                    "default": 8,
                    "description": "Minimum clair3 variant quality to PASS variant to final consensus"
                },
                "min_frameshift_qual": {
                    "type": "integer",
                    "default": 15,
                    "description": "Minimum clair3 frameshift (indel divisible by 3) variant quality to PASS variant to final consensus"
                },
                "min_allele_freq": {
                    "type": "number",
                    "default": 0.65,
                    "description": "Minimum clair3 allele frequency to PASS variant to final consensus"
                }
            }
        },
        "medaka_settings": {
            "title": "Medaka Settings (If using over clair3)",
            "type": "object",
            "description": "Settings pertaining to the medaka variant calling workflow if using medaka over clair3",
            "default": "",
            "fa_icon": "fas fa-tools",
            "properties": {
                "medaka_model": {
                    "type": "string",
                    "default": "r941_min_hac_g507",
                    "pattern": "^[A-Za-z0-9_\\-\\.]*$",
                    "description": "Model to use in medaka. See medaka docs for more info. Be as accurate as possible for best results!"
                },
                "skip_longshot": {
                    "type": "boolean",
                    "description": "If passed, skip running longshot with medaka pipeline",
                    "fa_icon": "fas fa-forward"
                }
            }
        },
        "nanopolish_settings": {
            "title": "Nanopolish Settings (If using over clair3)",
            "type": "object",
            "description": "Settings pertaining to the nanopolish variant calling workflow if using nanopolish over clair3. *NOTE*: nanopolish only works on R9 flowcells",
            "default": "",
            "fa_icon": "fas fa-tools",
            "properties": {
                "fast5_pass": {
                    "type": "string",
                    "format": "directoy-path",
                    "pattern": "^\\S+$",
                    "exists": true,
                    "fa_icon": "fas fa-folder",
                    "description": "Path to directory containing fast5 files REQUIRED for nanopolish"
                },
                "sequencing_summary": {
                    "type": "string",
                    "format": "file-path",
                    "pattern": "^\\S+$",
                    "exists": true,
                    "mimetype": "text/plain",
                    "fa_icon": "fas fa-file-alt",
                    "description": "Path to sequencing_summary file REQUIRED for nanopolish"
                }
            }
        },
        "read_filtering_options": {
            "title": "Read Filtering Options",
            "type": "object",
            "description": "Options pertaining to which samples to drop and how to filter reads",
            "default": "",
            "fa_icon": "fas fa-filter",
            "properties": {
                "min_reads": {
                    "type": "integer",
                    "default": 20,
                    "minimum": 0,
                    "description": "Minimum reads required to run the sample after length filtering"
                },
                "min_length": {
                    "type": "integer",
                    "default": 200,
                    "minimum": 0,
                    "description": "Minimum read length to keep"
                },
                "max_length": {
                    "type": "integer",
                    "default": 4000,
                    "minimum": 100,
                    "description": "Maximum read length to keep"
                }
            }
        },
        "general_analysis_options": {
            "title": "General Analysis Calling Options",
            "type": "object",
            "description": "Options pertaining to all variant calling methods",
            "default": "",
            "properties": {
                "normalise": {
                    "type": "integer",
                    "default": 1000,
                    "minimum": 0,
                    "description": "Normalize coverage for each amplicon to this threshold",
                    "fa_icon": "fas fa-balance-scale"
                },
                "min_depth": {
                    "type": "integer",
                    "default": 20,
                    "minimum": 0,
                    "description": "Minimum depth to call a position. Positions lower are masked with an N"
                },
                "no_frameshift": {
                    "type": "boolean",
                    "description": "Filter out INDEL variants that are not divisible by 3 (likely frameshift but not necessarily)"
                },
                "metadata": {
                    "type": "string",
                    "fa_icon": "fas fa-file-csv",
                    "mimetype": "text/csv",
                    "pattern": "^\\S+\\.tsv$",
                    "description": "Path to metadata TSV file containing at least columns 'sample' and 'barcode'"
                },
                "use_artic_tool": {
                    "type": "boolean",
                    "description": "Pass to run tool artic pipeline instead of the nextflow adaptation this pipeline uses"
                }
            }
        },
        "qc_options": {
            "title": "QC options",
            "type": "object",
            "description": "Options pertaining to QC outputs/stats",
            "default": "",
            "fa_icon": "fas fa-star",
            "properties": {
                "skip_qc": {
                    "type": "boolean",
                    "fa_icon": "fas fa-forward",
                    "description": "If passed, skip running all QC and reporting steps"
                },
                "pcr_primer_bed": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "mimetype": "text/plain",
                    "description": "Path to 6 column (minimum) tab separated PCR primer bed file with first column matching reference ID to report mutations in these locations",
                    "fa_icon": "fas fa-font"
                },
                "neg_control_threshold": {
                    "type": "number",
                    "default": 0.1,
                    "minimum": 0,
                    "maximum": 1,
                    "description": "Float threshold for a negative control sample to be considered contaminated"
                },
                "neg_ctrl_substrings": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_,\\-\\.]*$",
                    "default": "neg,ntc,blank,water",
                    "description": "Control prefixes separated by a ',' to determine which samples are negative controls"
                }
            }
        },
        "snpeff_options": {
            "title": "SnpEff options",
            "type": "object",
            "description": "Options pertaining to running SnpEff for variant annotation",
            "default": "",
            "properties": {
                "skip_snpeff": {
                    "type": "boolean",
                    "description": "If passed, skips running SnpEff",
                    "fa_icon": "fas fa-forward"
                },
                "gff": {
                    "type": "string",
                    "format": "file-path",
                    "mimetype": "text/plain",
                    "pattern": "^\\S+\\.gff3?(\\.gz)?$",
                    "description": "Path to GFF annotation file.",
                    "fa_icon": "fas fa-file-invoice"
                }
            }
        },
        "nextclade_options": {
            "title": "Nextclade options",
            "type": "object",
            "description": "Options pertaining to running nextclade",
            "default": "",
            "properties": {
                "skip_nextclade": {
                    "type": "boolean",
                    "description": "If passed, skips running Nextclade",
                    "fa_icon": "fas fa-forward"
                },
                "nextclade_dataset_dir": {
                    "type": "string",
                    "format": "directory-path",
                    "mimetype": "text/plain",
                    "description": "Path to local nextclade dataset.",
                    "fa_icon": "fas fa-file-invoice"
                },
                "nextclade_dataset_name": {
                    "type": "string",
                    "description": "Name of the nextclade dataset to use."
                },
                "nextclade_dataset_tag": {
                    "type": "string",
                    "description": "Tag for the nextclade dataset to use."
                },
                "virus_name": {
                    "type": "string",
                    "description": "Virus name to be used in nextclade process",
                    "pattern": "(?i)^(covid|rsv_a|rsv_b|mpox|ebola|sudan|measles|dengue|yfv|hmpv|rubella|mumps)$"
                },
                "nextclade_covid_dataset": {
                    "type": "string",
                    "description": "Preset nextclade dataset for SARS-COV-2"
                },
                "nextclade_rsv_a_dataset": {
                    "type": "string",
                    "description": "Preset nextclade dataset for Respiratory Syncytial Virus A"
                },
                "nextclade_rsv_b_dataset": {
                    "type": "string",
                    "description": "Preset nextclade dataset for Respiratory Syncytial Virus B"
                },
                "nextclade_mpox_dataset": {
                    "type": "string",
                    "description": "Preset nextclade dataset Monkeypox Virus"
                },
                "nextclade_ebola_dataset": {
                    "type": "string",
                    "description": "Preset nextclade dataset for Ebola Virus"
                },
                "nextclade_sudan_dataset": {
                    "type": "string",
                    "description": "Preset nextclade dataset for Sudan Virus"
                },
                "nextclade_measles_dataset": {
                    "type": "string",
                    "description": "Preset nextclade dataset Measles Virus"
                },
                "nextclade_dengue_dataset": {
                    "type": "string",
                    "description": "Preset nextclade dataset Dengue Virus"
                },
                "nextclade_yfv_dataset": {
                    "type": "string",
                    "description": "Preset nextclade dataset for Yellow Fever Virus"
                },
                "nextclade_hmpv_dataset": {
                    "type": "string",
                    "description": "Preset nextclade dataset for Human Metapneumovirus"
                },
                "nextclade_rubella_dataset": {
                    "type": "string",
                    "description": "Preset nextclade dataset for Rubella Virus"
                },
                "nextclade_mumps_dataset": {
                    "type": "string",
                    "description": "Preset nextclade dataset for Mumps Virus"
                }
            }
        },
        "report_generation_options": {
            "title": "Report generation options",
            "type": "object",
            "description": "Options pertaining to final report generation",
            "default": "",
            "properties": {
                "multiqc_report": {
                    "type": "boolean",
                    "fa_icon": "fas fa-file-signature",
                    "description": "Create MultiQC report instead of custom report"
                },
                "multiqc_config_overall": {
                    "type": "string",
                    "format": "file-path",
                    "description": "MultiQC overall run config yaml file",
                    "hidden": true
                },
                "multiqc_config_sample": {
                    "type": "string",
                    "format": "file-path",
                    "description": "MultiQC sample config yaml file",
                    "hidden": true
                }
            },
            "fa_icon": "fas fa-file-code"
        },
        "generic_options": {
            "title": "Generic options",
            "type": "object",
            "fa_icon": "fas fa-file-import",
            "description": "Less common options for the pipeline, typically set in a config file.",
            "help_text": "These options are common to all nf-core pipelines and allow you to customise some of the core preferences for how the pipeline runs.\n\nTypically these options would be set in a Nextflow config file loaded for all pipeline runs, such as `~/.nextflow/config`.",
            "properties": {
                "help": {
                    "type": "boolean",
                    "description": "Display help message and exit.",
                    "fa_icon": "fas fa-question-circle"
                },
                "version": {
                    "type": "boolean",
                    "description": "Display version and exit.",
                    "fa_icon": "fas fa-question-circle"
                },
                "publish_dir_mode": {
                    "type": "string",
                    "default": "copy",
                    "description": "Method used to save pipeline results to output directory.",
                    "help_text": "The Nextflow `publishDir` option specifies which intermediate files should be saved to the output directory. This option tells the pipeline what method should be used to move these files. See [Nextflow docs](https://www.nextflow.io/docs/latest/process.html#publishdir) for details.",
                    "fa_icon": "fas fa-copy",
                    "enum": ["symlink", "rellink", "link", "copy", "copyNoFollow", "move"],
                    "hidden": true
                },
                "monochrome_logs": {
                    "type": "boolean",
                    "description": "Do not use coloured log outputs.",
                    "fa_icon": "fas fa-palette",
                    "hidden": true
                },
                "validate_params": {
                    "type": "boolean",
                    "description": "Boolean whether to validate parameters against the schema at runtime",
                    "default": true,
                    "fa_icon": "fas fa-check-square",
                    "hidden": true
                },
                "trace_report_suffix": {
                    "type": "string",
                    "fa_icon": "far calendar",
                    "description": "Suffix to add to the trace report filename. Default is the date and time in the format yyyy-MM-dd_HH-mm-ss.",
                    "hidden": true
                }
            }
        }
    },
    "allOf": [
        {
            "$ref": "#/definitions/input_output_options"
        },
        {
            "$ref": "#/definitions/required_settings"
        },
        {
            "$ref": "#/definitions/amplicon_settings"
        },
        {
            "$ref": "#/definitions/clair3_settings"
        },
        {
            "$ref": "#/definitions/medaka_settings"
        },
        {
            "$ref": "#/definitions/nanopolish_settings"
        },
        {
            "$ref": "#/definitions/read_filtering_options"
        },
        {
            "$ref": "#/definitions/general_analysis_options"
        },
        {
            "$ref": "#/definitions/snpeff_options"
        },
        {
            "$ref": "#/definitions/nextclade_options"
        },
        {
            "$ref": "#/definitions/qc_options"
        },
        {
            "$ref": "#/definitions/report_generation_options"
        },
        {
            "$ref": "#/definitions/generic_options"
        }
    ]
}
