/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    // ~~~~~~~~~~~~~~~~~~~~~~~ //
    // Output Path Adjustments
    // ~~~~~~~~~~~~~~~~~~~~~~~ //

    withName: "ARTIC_MINION" {
        publishDir = [[
            path: { "${params.outdir}/consensus" },
            pattern: "*.consensus.fasta",
            mode: params.publish_dir_mode,
        ],
        [
            path: { "${params.outdir}/bam" },
            pattern: "*bam*",
            mode: params.publish_dir_mode,
        ],
        [
            path: { "${params.outdir}/vcf" },
            pattern: "*.pass.vcf*",
            mode: params.publish_dir_mode,
        ],
        [
            path: { "${params.outdir}/vcf" },
            pattern: "*.fail.vcf",
            mode: params.publish_dir_mode,
        ]]
    }

    withName: "BCFTOOLS_CONSENSUS" {
        publishDir = [
            path: { "${params.outdir}/consensus" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: "BCFTOOLS_NORM" {
        publishDir = [
            path: { "${params.outdir}/vcf" },
            pattern: "*.pass.norm.vcf.gz",
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: "CREATE_ALL_SAMPLE_SUMMARY_REPORT" {
        publishDir = [
            path: { "${params.outdir}" },
            pattern: "reportDashboard.html",
            mode: params.publish_dir_mode,
        ]
    }

    withName: "CREATE_READ_VARIATION_CSV" {
        publishDir = [
            path: { "${params.outdir}/variation_csvs" },
            pattern: "*.csv",
            mode: params.publish_dir_mode,
        ]
    }

    withName: "CREATE_TILING_BED" {
        publishDir = [
            path: { "${params.outdir}/bed" },
            pattern: "*.bed",
            mode: params.publish_dir_mode,
        ]
    }

    withName: CUSTOM_DUMPSOFTWAREVERSIONS {
        publishDir = [
            path: { "${params.outdir}/pipeline_info" },
            mode: 'copy',
            pattern: '*_versions.yml'
        ]
    }

    withName: "FINAL_QC_CSV" {
        publishDir = [
            path: { "${params.outdir}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: "GET_REF_STATS" {
        publishDir = [
            path: { "${params.outdir}/reference" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: "LONGSHOT" {
        publishDir = [
            path: { "${params.outdir/vcf}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: "MINIMAP2_ALIGN" {
        publishDir = [
            path: { "${params.outdir}/bam" },
            pattern: "*.sorted.bam*",
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: "MULTIQC_SAMPLE" {
        publishDir = [
            path: { "${params.outdir}/sample_mqc" },
            pattern: "*.html",
            mode: params.publish_dir_mode,
        ]
    }

    withName: "MULTIQC_OVERALL" {
        publishDir = [
            path: { "${params.outdir}" },
            pattern: "*.html",
            mode: params.publish_dir_mode,
        ]
    }

    withName: "MAKE_SAMPLE_QC_CSV" {
        publishDir = [
            path: { "${params.outdir}/sample_csvs" },
            pattern: "*.csv",
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: "PRIMALBEDTOOLS_AMPLICON" {
        publishDir = [
            path: { "${params.outdir}/bed" },
            pattern: "*.bed",
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: "SNPEFF_DATABASE" {
        publishDir = [
            path: { "${params.outdir}/snpeff/database" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: "SNPEFF_ANNOTATE" {
        publishDir = [[
            path: { "${params.outdir}/snpeff" },
            pattern: "*.csv",
            mode: params.publish_dir_mode,
        ],
        [
            path: { "${params.outdir}/snpeff" },
            pattern: "*.vcf",
            mode: params.publish_dir_mode,
        ]]
    }

    withName: "SPLIT_BED_BY_POOL" {
        publishDir = [
            path: { "${params.outdir}/bed" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }
}
